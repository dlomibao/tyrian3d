{
  "name": "tyrian3d",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "play:local": "VITE_LOCAL_DATA=1 vite build --outDir dist-local --emptyOutDir && vite preview --outDir dist-local --port 4173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "songs-to-midi": "MIDI_OUT=${MIDI_OUT:-../tyrian3d-remaster/source} vitest run tests/tools/ldsToMidi.test.ts",
    "catalogue": "CATALOGUE_OUT=${CATALOGUE_OUT:-reference/models} vitest run tests/tools/spriteCatalogue.test.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
